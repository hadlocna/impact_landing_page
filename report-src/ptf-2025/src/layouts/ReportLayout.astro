---
// Page shell: fonts, stylesheet, fixed navigation chrome, and the scroll/parallax
// script. The report body is provided via <slot /> inside <main id="report">.
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Pela Terra Farmland — 2025 Impact Report</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Libre+Franklin:ital,wght@0,300;0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap"
  rel="stylesheet"
/>
<link rel="stylesheet" href="/impactreports/2025/ptf/report-web.css" />
</head>
<body>

<div id="progress"></div>

<header id="topbar">
  <div class="tb-title"><b>Pela Terra Farmland</b> · 2025 Impact Report<span class="tb-current" id="tbCurrent"></span></div>
  <button id="menuBtn" type="button" aria-label="Open contents"><span class="bars"><i></i><i></i><i></i></span>Contents</button>
</header>

<div id="overlay" role="dialog" aria-modal="true" aria-label="Contents">
  <div class="ov-inner">
    <div class="ov-head">
      <span>Contents</span>
      <button id="ovClose" type="button" aria-label="Close contents">&times;</button>
    </div>
    <nav id="ovNav"></nav>
  </div>
</div>

<main id="report">
  <slot />
</main>

<script src="/impactreports/2025/ptf/report-web.js" is:inline></script>
</body>
</html>
