---
import Divider from './Divider.astro';
---
<Divider
  id="sec-10"
  section="X · Our KPIs in Detail"
  num="Section X"
  title="Our KPIs in Detail"
  bg="/impactreports/2025/ptf/images/pruning.jpg"
/>

<section class="section" data-section="X · Our KPIs in Detail" data-break>
  <div class="wide">
    <table class="kpi-table kpi-detail reveal">
      <colgroup>
        <col style="width:52px"><col style="width:138px"><col style="width:44px"><col style="width:236px">
        <col style="width:34px"><col style="width:86px"><col style="width:90px"><col style="width:86px"><col style="width:96px"><col style="width:24px">
      </colgroup>
      <thead>
        <tr>
          <th>Theme</th><th>2030 target (KPI)</th><th>SDG</th><th>Sub-indicator</th>
          <th class="kd-base">Base. yr</th><th class="kd-num">Maria Pires '25</th><th class="kd-num">Couto '25</th><th class="kd-num kd-ov">Overall (PTF) '25</th><th class="kd-num kd-ch">Δ vs 2024</th><th class="kd-rag">RAG</th>
        </tr>
      </thead>
      <tbody>
        <tr><td class="kd-theme" rowspan="4">Soil</td><td class="kd-kpi" rowspan="4">Achieve an average 20% improvement in soil-health indicators on all assets</td><td class="kd-sdg">15.3</td><td class="kd-sub">1.1 · Soil Organic Carbon (%)</td><td class="kd-base">2024</td><td class="kd-num">0.82</td><td class="kd-num">0.52</td><td class="kd-num kd-ov">0.70</td><td class="kd-num kd-ch">45%</td><td class="kd-rag"><span class="dot rag-achieved" title="Achieved"></span></td></tr>
        <tr><td class="kd-sdg">15.3</td><td class="kd-sub">1.2 · Soil Aggregate Stability (mins)</td><td class="kd-base">2025</td><td class="kd-num">1.5</td><td class="kd-num"><span class="kd-dim">Not measured</span></td><td class="kd-num kd-ov">1.50</td><td class="kd-num kd-ch"><span class="kd-dim">New for 2025</span></td><td class="kd-rag"><span class="dot rag-ontrack" title="On track to achieve"></span></td></tr>
        <tr><td class="kd-sdg">15.3</td><td class="kd-sub">1.3 · Soil Microbial Biomass (μg C/g)</td><td class="kd-base">2025</td><td class="kd-num">206</td><td class="kd-num"><span class="kd-dim">Not measured</span></td><td class="kd-num kd-ov">206.00</td><td class="kd-num kd-ch"><span class="kd-dim">New for 2025</span></td><td class="kd-rag"><span class="dot rag-ontrack" title="On track to achieve"></span></td></tr>
        <tr><td class="kd-sdg">15.3</td><td class="kd-sub">1.4 · Soil Cation Exchange Capacity (meq/100g)</td><td class="kd-base">2025</td><td class="kd-num">11.8</td><td class="kd-num">10.0</td><td class="kd-num kd-ov">11.04</td><td class="kd-num kd-ch"><span class="kd-dim">New for 2025</span></td><td class="kd-rag"><span class="dot rag-ontrack" title="On track to achieve"></span></td></tr>
        <tr><td class="kd-theme" rowspan="1">Water</td><td class="kd-kpi" rowspan="1">Achieve a 10% decrease in water wastage through more efficient irrigation</td><td class="kd-sdg">6.4</td><td class="kd-sub">2.1 · Operator assessment of water wastage</td><td class="kd-base">2024</td><td class="kd-num">10%</td><td class="kd-num">10%</td><td class="kd-num kd-ov">10%</td><td class="kd-num kd-ch">10%</td><td class="kd-rag"><span class="dot rag-achieved" title="Achieved"></span></td></tr>
        <tr><td class="kd-theme" rowspan="4">Climate</td><td class="kd-kpi" rowspan="1">Reduce synthetic fertiliser inputs by 30% on a per-hectare basis</td><td class="kd-sdg">2.4, 13.2</td><td class="kd-sub">3.1 · Synthetic fertiliser applied per hectare (kg N)</td><td class="kd-base">2023</td><td class="kd-num">165.8</td><td class="kd-num">0.0</td><td class="kd-num kd-ov">97.10</td><td class="kd-num kd-ch">−21%</td><td class="kd-rag"><span class="dot rag-ontrack" title="On track to achieve"></span></td></tr>
        <tr><td class="kd-kpi" rowspan="3">Achieve net negative greenhouse-gas emissions on a per-hectare level</td><td class="kd-sdg">7.2, 13.2</td><td class="kd-sub">4.1 · Energy needs met by on-farm renewable sources (%)</td><td class="kd-base">2023</td><td class="kd-num">0</td><td class="kd-num">100</td><td class="kd-num kd-ov">41.43</td><td class="kd-num kd-ch">No change</td><td class="kd-rag"><span class="dot rag-ontrack" title="On track to achieve"></span></td></tr>
        <tr><td class="kd-sdg">13.2</td><td class="kd-sub">4.2 · Reduce Scope 1, 2 &amp; 3 GHG emissions by 30% per hectare</td><td class="kd-base">2025</td><td class="kd-num kd-span" colspan="4"><span class="kd-dim">Not yet measured</span></td><td class="kd-rag"><span class="dot rag-tbd" title="Baseline not yet defined"></span></td></tr>
        <tr><td class="kd-sdg">13.2</td><td class="kd-sub">4.3 · Sequester 10 tonnes of CO₂ per hectare under management</td><td class="kd-base">2022</td><td class="kd-num">12.79</td><td class="kd-num"><span class="kd-dim">Not yet measured</span></td><td class="kd-num kd-ov">7.30</td><td class="kd-num kd-ch"><span class="kd-dim">New for 2025</span></td><td class="kd-rag"><span class="dot rag-achieved" title="Achieved"></span></td></tr>
        <tr><td class="kd-theme" rowspan="6">Biodiversity</td><td class="kd-kpi" rowspan="1">Reduce herbicide use by 30%</td><td class="kd-sdg">3.9, 15.5</td><td class="kd-sub">5.1 · Herbicide applied per hectare (kg active ingredient)</td><td class="kd-base">2024</td><td class="kd-num">3.21</td><td class="kd-num">1.25</td><td class="kd-num kd-ov">2.40</td><td class="kd-num kd-ch">−59%</td><td class="kd-rag"><span class="dot rag-achieved" title="Achieved"></span></td></tr>
        <tr><td class="kd-kpi" rowspan="1">Reduce pesticide use by 20%</td><td class="kd-sdg">3.9, 15.5</td><td class="kd-sub">6.1 · Pesticide applied per hectare (kg a.i., excluding herbicides)</td><td class="kd-base">2024</td><td class="kd-num">4.17</td><td class="kd-num">0.24</td><td class="kd-num kd-ov">2.57</td><td class="kd-num kd-ch">0%</td><td class="kd-rag"><span class="dot rag-risk" title="At risk / negative progress from baseline"></span></td></tr>
        <tr><td class="kd-kpi" rowspan="3">Achieve net positive biodiversity for all assets</td><td class="kd-sdg">15.5</td><td class="kd-sub">7.1 · Detailed habitat assessments (NBI or equivalent)</td><td class="kd-base">2023–4</td><td class="kd-num">2.86</td><td class="kd-num">2.43</td><td class="kd-num kd-ov">2.68</td><td class="kd-num kd-ch"><span class="kd-dim">Not measured this year</span></td><td class="kd-rag"><span class="dot rag-risk" title="At risk / negative progress from baseline"></span></td></tr>
        <tr><td class="kd-sdg">15.5</td><td class="kd-sub">7.2 · Grassland butterfly index</td><td class="kd-base">2026</td><td class="kd-num kd-span" colspan="4"><span class="kd-dim">Not yet measured</span></td><td class="kd-rag"><span class="dot rag-tbd" title="Baseline not yet defined"></span></td></tr>
        <tr><td class="kd-sdg">15.5</td><td class="kd-sub">7.3 · Farmland bird index</td><td class="kd-base">2026</td><td class="kd-num kd-span" colspan="4"><span class="kd-dim">Not yet measured</span></td><td class="kd-rag"><span class="dot rag-tbd" title="Baseline not yet defined"></span></td></tr>
        <tr><td class="kd-kpi" rowspan="1">Set aside ≥20% of land under management, managed primarily for biodiversity</td><td class="kd-sdg">15.5, 15.a</td><td class="kd-sub">8.1 · Land managed for biodiversity / total land managed (%)</td><td class="kd-base">N/A</td><td class="kd-num">136 ha · 26%</td><td class="kd-num">39 ha · 10.8%</td><td class="kd-num kd-ov">175 ha · 20%</td><td class="kd-num kd-ch">No change</td><td class="kd-rag"><span class="dot rag-achieved" title="Achieved"></span></td></tr>
        <tr><td class="kd-theme" rowspan="7">Human Health</td><td class="kd-kpi" rowspan="4">Achieve a 10% increase in nutrient-density levels of all produce at harvest</td><td class="kd-sdg">2.1</td><td class="kd-sub">9.1 · Minerals and metals</td><td class="kd-base">2026</td><td class="kd-num kd-span" colspan="4"><span class="kd-dim">Not measured in 2025</span></td><td class="kd-rag"><span class="dot rag-tbd" title="Baseline not yet defined"></span></td></tr>
        <tr><td class="kd-sdg">2.1</td><td class="kd-sub">9.2 · Fatty Acid Profile Determination</td><td class="kd-base">2026</td><td class="kd-num kd-span" colspan="4"><span class="kd-dim">Not measured in 2025 · no harvest yet at Couto</span></td><td class="kd-rag"><span class="dot rag-tbd" title="Baseline not yet defined"></span></td></tr>
        <tr><td class="kd-sdg">2.1</td><td class="kd-sub">9.3 · Polyphenols</td><td class="kd-base">2026</td><td class="kd-num kd-span" colspan="4"><span class="kd-dim">Not measured in 2025 · no harvest yet at Couto</span></td><td class="kd-rag"><span class="dot rag-tbd" title="Baseline not yet defined"></span></td></tr>
        <tr><td class="kd-sdg">2.1</td><td class="kd-sub">9.4 · Vitamins</td><td class="kd-base">2026</td><td class="kd-num kd-span" colspan="4"><span class="kd-dim">Not measured in 2025 · no harvest yet at Couto</span></td><td class="kd-rag"><span class="dot rag-tbd" title="Baseline not yet defined"></span></td></tr>
        <tr><td class="kd-kpi" rowspan="3">Reduce pesticide residues at harvest to under 50% of the EU’s MRLs</td><td class="kd-sdg">3.9</td><td class="kd-sub">10.1 · Insecticides</td><td class="kd-base">N/A</td><td class="kd-num kd-span" colspan="4"><span class="kd-dim">Not measured in 2025 · no harvest yet at Couto</span></td><td class="kd-rag"><span class="dot rag-tbd" title="Baseline not yet defined"></span></td></tr>
        <tr><td class="kd-sdg">3.9</td><td class="kd-sub">10.2 · Fungicides</td><td class="kd-base">N/A</td><td class="kd-num kd-span" colspan="4"><span class="kd-dim">Not measured in 2025 · no harvest yet at Couto</span></td><td class="kd-rag"><span class="dot rag-tbd" title="Baseline not yet defined"></span></td></tr>
        <tr><td class="kd-sdg">3.9</td><td class="kd-sub">10.3 · Herbicides</td><td class="kd-base">N/A</td><td class="kd-num kd-span" colspan="4"><span class="kd-dim">Not measured in 2025 · no harvest yet at Couto</span></td><td class="kd-rag"><span class="dot rag-tbd" title="Baseline not yet defined"></span></td></tr>
        <tr><td class="kd-theme" rowspan="2">Society</td><td class="kd-kpi" rowspan="1">Make 100% of our capital investments in rural areas of Portugal</td><td class="kd-sdg">15.a</td><td class="kd-sub">11.1 · Capital invested in rural Portugal / total capital</td><td class="kd-base">N/A</td><td class="kd-num">100%</td><td class="kd-num"><span class="kd-dim">—</span></td><td class="kd-num kd-ov"><span class="kd-dim">—</span></td><td class="kd-num kd-ch">No change</td><td class="kd-rag"><span class="dot rag-achieved" title="Achieved"></span></td></tr>
        <tr><td class="kd-kpi" rowspan="1">Create 5 good jobs in rural areas of Portugal</td><td class="kd-sdg">8.8</td><td class="kd-sub">12.1 · Total FTE jobs created directly from PTF investments</td><td class="kd-base">N/A</td><td class="kd-num">9.74</td><td class="kd-num"><span class="kd-dim">—</span></td><td class="kd-num kd-ov">9.74</td><td class="kd-num kd-ch">+4.74</td><td class="kd-rag"><span class="dot rag-achieved" title="Achieved"></span></td></tr>
      </tbody>
    </table>
    <div class="kd-key reveal">
      <span class="kd-key__lbl">2025 Status — RAG</span>
      <span><span class="dot rag-achieved"></span>Achieved</span>
      <span><span class="dot rag-ontrack"></span>On track</span>
      <span><span class="dot rag-risk"></span>At risk / negative</span>
      <span><span class="dot rag-tbd"></span>Baseline pending</span>
    </div>
  </div>
</section>
